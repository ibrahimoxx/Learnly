# ============================================================
# Learnly — Environment Variables
# Copy to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ============================================================

# === Application ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# === Database (PostgreSQL) ===
POSTGRES_USER=learnly
POSTGRES_PASSWORD=learnly_dev
POSTGRES_DB=learnly
DATABASE_URL=postgresql+asyncpg://learnly:learnly_dev@localhost:5432/learnly

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Auth (Clerk) ===
# Get from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=whsec_

# === Object Storage (MinIO local / R2 prod) ===
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=learnly
S3_SECRET_KEY=learnly_dev_secret
S3_BUCKET=learnly-media
S3_PUBLIC_URL=http://localhost:9000/learnly-media
MINIO_ROOT_USER=learnly
MINIO_ROOT_PASSWORD=learnly_dev_secret

# === Search (Meilisearch) ===
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=learnly_meili_dev

# === Email ===
EMAIL_PROVIDER=mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@learnly.dev
# Production only:
# RESEND_API_KEY=re_

# === Payments (Stripe) ===
# Get from https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_CONNECT_CLIENT_ID=ca_

# === Video (local FFmpeg / Cloudflare Stream prod) ===
VIDEO_PROVIDER=local
# Production only:
# CF_STREAM_ACCOUNT_ID=
# CF_STREAM_API_TOKEN=

# === Analytics ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# === Monitoring (production only) ===
# SENTRY_DSN_FRONTEND=
# SENTRY_DSN_BACKEND=

# === Feature Flags ===
FEATURE_LIVE_SESSIONS=false
FEATURE_AFFILIATE=false
